<?xml version="1.0" encoding="utf-8"?>
<com.google.android.gms.ads.nativead.NativeAdView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/native_ad_view"
    android:background="#181818"
    android:layout_width="match_parent"
    android:layout_height="120dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="8dp">

        <!-- Media -->
        <FrameLayout
            android:id="@+id/card_media"
            android:layout_width="180dp"
            android:layout_height="0dp"
            android:clipToOutline="true"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <com.google.android.gms.ads.nativead.MediaView
                android:id="@+id/ad_media"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

        </FrameLayout>

        <!-- Ad Badge -->
        <TextView
            android:id="@+id/ad_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/ad_text"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:text="Ad"
            android:textColor="#20C197"
            android:textSize="11sp"
            android:textStyle="bold"
            android:elevation="5dp"
            android:layout_marginTop="4dp"
            android:layout_marginStart="4dp"
            app:layout_constraintTop_toTopOf="@id/card_media"
            app:layout_constraintStart_toStartOf="@id/card_media" />

        <!-- App Icon -->
        <FrameLayout
            android:id="@+id/card_icon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="12dp"
            android:clipToOutline="true"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toEndOf="@id/card_media">

            <ImageView
                android:id="@+id/ad_app_icon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@mipmap/ic_launcher" />

        </FrameLayout>

        <!-- Headline -->
        <TextView
            android:id="@+id/ad_headline"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:singleLine="true"
            android:textColor="@color/gnt_white"
            android:textSize="13sp"
            android:textStyle="bold"
            android:text=""
            app:layout_constraintTop_toTopOf="@id/card_icon"
            app:layout_constraintBottom_toBottomOf="@id/card_icon"
            app:layout_constraintStart_toEndOf="@id/card_icon"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Body -->
        <TextView
            android:id="@+id/ad_body"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/gnt_white"
            android:textSize="11sp"
            android:text=""
            app:layout_constraintTop_toBottomOf="@id/card_icon"
            app:layout_constraintStart_toStartOf="@id/card_icon"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- CTA -->
        <com.pianokeyboard.virtualpiano.learnpiano.ShimmerButton
            android:id="@+id/ad_call_to_action"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_button_ads"
            android:gravity="center"
            android:text="Open"
            android:textColor="@color/gnt_white"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="@id/card_icon"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.gms.ads.nativead.NativeAdView>